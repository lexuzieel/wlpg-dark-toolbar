[ProcessesToRunBeforeArchive]
"%sourcepath%\unregmp2.exe /PreInstall"
"%sourcepath%\unregmp2.exe /RegUniv"


"""%16422%\%WMC2DIR_NAME%\Wmccds.exe"" uninstall"
"%systemroot%\system32\regsvr32.exe /s /u ""%16422%\%WMC2DIR_NAME%\wmccpl.dll"""
"%systemroot%\system32\regsvr32.exe /s /u ""%16422%\%WMC2DIR_NAME%\wmcsci.dll"""
"%sourcepath%\unregmp2.exe /HideWMC20Shortcut"


